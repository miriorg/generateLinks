# target.list - generateLinks sample list file
# =========================================================================
# One path per line = a link to be created (the link destination).
# Blank lines and lines starting with '#' are ignored.
# %VAR%, $env:VAR and a leading ~ are expanded.
# Relative paths are resolved against THIS file's folder.
#
# Usage:
#   .\generateLinks.ps1 CLAUDE.md                 # symlink CLAUDE.md -> each path below
#   .\generateLinks.ps1 --check --target CLAUDE.md
#   .\generateLinks.ps1 --target CLAUDE.md --overwrite
#
# The lines below are COMMENTED OUT on purpose. Uncomment / edit the ones
# you actually want, or point --source at your own list file.
# =========================================================================

# --- Common per-user locations for AI assistant instruction files ---------
# ~\.claude\CLAUDE.md
# ~\.gemini\GEMINI.md
# ~\.codex\AGENTS.md
# ~\.github\copilot-instructions.md
# ~\.cursor\rules\main.mdc
# ~\.aider.conf.md
# ~\.codeium\windsurf\memories\global_rules.md

# --- Example with environment variables ----------------------------------
# %USERPROFILE%\Documents\shared-instructions.md
# $env:APPDATA\SomeTool\instructions.md
